# ==============================================================================
# AloUTE Canonical Environment Configuration Example
# Copy to root .env (or server /etc/aloute/.env). Do NOT commit real secrets.
# ==============================================================================

# --- Application Runtime & Domain ---
# Safe default for local development is 'dev' (uses H2 in-memory database).
# In production / staging deployment, set to 'prod' and supply MySQL + secret credentials.
SPRING_PROFILES_ACTIVE=dev
ALOUTE_DOMAIN=localhost
ALOUTE_APP_BASE_URL=http://localhost:8080

# --- Database Credentials (MySQL 8 for prod; ignored in dev default) ---
MYSQL_DATABASE=aloutedb
MYSQL_USER=aloute_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

# --- Authentication & Cryptographic Secrets ---
# Must be Base64-encoded cryptographically secure random bytes (>= 32 bytes / 256 bits).
# Required when running in prod profile; fail-closed if omitted or empty.
ALOUTE_JWT_SECRET=
ALOUTE_JWT_EXPIRATION_SECONDS=86400
ALOUTE_REGISTRATION_OTP_SECRET=

# --- SMTP Mail Delivery Configuration ---
# Local development: leave ALOUTE_MAIL_HOST blank for simulated delivery (no network transport),
# or point to a local test sink (e.g. localhost / port 2525).
# Production / External Gmail:
#   ALOUTE_MAIL_HOST=smtp.gmail.com
#   ALOUTE_MAIL_PORT=587
#   ALOUTE_MAIL_USERNAME=your-account@gmail.com
#   ALOUTE_MAIL_PASSWORD=your-16-character-app-password
#   ALOUTE_MAIL_FROM=your-account@gmail.com (must correspond to owner authenticated account)
ALOUTE_MAIL_HOST=
ALOUTE_MAIL_PORT=587
ALOUTE_MAIL_USERNAME=
ALOUTE_MAIL_PASSWORD=
ALOUTE_MAIL_FROM=noreply@aloute.edu.vn
